   "source": [
    "# Initialize the map\n",
    "site_map = folium.Map(location=nasa_coordinate, zoom_start=5)\n",
    "\n",
    "# Iterate through each launch site to add a circle and a marker\n",
    "for index, site in launch_sites_df.iterrows():\n",
    "    coordinate = [site['Lat'], site['Long']]\n",
    "    site_name = site['Launch Site']\n",
    "\n",
    "    circle = folium.Circle(coordinate, radius=1000, color='#0000FF', fill=True).add_child(folium.Popup('site_name'))\n",
    "    \n",
    "    # Add a marker with a text label\n",
    "    marker = folium.map.Marker(\n",
    "        coordinate,\n",
    "        icon=DivIcon(\n",
    "            icon_size=(20, 20),\n",
    "            icon_anchor=(0, 0),\n",
    "            html=f'<div style=\"font-size: 15; color:#0000FF;\"><b>{site_name}</b></div>',) )\n",
    "    \n",
    "    # Add a blue dotted line along the equator (Latitude 0)\n",
    "    equator = folium.PolyLine(\n",
    "        locations=[[0, -180], [0, 180]],\n",
    "        color='blue',\n",
    "        weight=2,\n",
    "        dash_array='5, 10')\n",
    "\n",
    "    site_map.add_child(equator)\n",
    "    site_map.add_child(circle)\n",
    "    site_map.add_child(marker)\n",
    "\n",
    "# Display the map\n",
    "site_map"
   ]
  },
