    "# Define your launch site and closest coastline coordinates\n",
    "launch_site_coord = [28.573255, -80.646895]  # Example: KSC LC-39A\n",
    "coastline_coord = [28.56342, -80.56794]     # Replace with your clicked coastline coordinates\n",
    "\n",
    "# Calculate the distance\n",
    "distance = calculate_distance(\n",
    "    launch_site_coord[0], launch_site_coord[1], \n",
    "    coastline_coord[0], coastline_coord[1]\n",
    ")\n",
    "\n",
    "# Create the distance marker using DivIcon\n",
    "distance_marker = folium.Marker(\n",
    "    coastline_coord,\n",
    "    icon=DivIcon(\n",
    "        icon_size=(20, 20),\n",
    "        icon_anchor=(0, 0),\n",
    "        html='<div style=\"font-size: 12; color:#d35400;\"><b>%s</b></div>' % \"{:10.2f} KM\".format(distance),\n",
    "    )\n",
    ")\n",
    "\n",
    "# Add the marker to the map\n",
    "site_map.add_child(distance_marker)\n"
   ]
